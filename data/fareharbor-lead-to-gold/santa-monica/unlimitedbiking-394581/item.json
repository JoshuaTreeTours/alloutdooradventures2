{"item": {"cls": "Item", "uri": "/api/v1/companies/unlimitedbiking/items/394581/", "pk": 394581, "company": {"cls": "Company", "uri": "/api/v1/companies/unlimitedbiking/", "pk": 5980, "shortname": "unlimitedbiking", "name": "Unlimited Biking", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Santa Monica eBike Rentals", "is_retail": false, "is_archived": false, "is_private": false, "color": 8, "unicode": "Santa Monica eBike Rentals", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": -3.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": -3.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": true, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 270000, "description": "Enjoy the best of West Los Angeles with this self-guided electric bike ride that begins in Santa Monica near the famous Santa Monica Pier! Our pedal assist, Cannondale Electric bikes are perfect for riders looking for an extra boost. Feel the ocean breeze as you zip through Marina del Rey, take a photo opportunity at Muscle Beach and the Venice Canals, and experience the famous Art Walls. Santa Monica has a rich cultural history and stunning scenery.\n\nGuests must be 16+ to ride an electric bike! For safety reasons, we are unable to attach trailers or tag-a-longs to ebikes.\n\nPlease be aware of our **Store Hours**, as bikes must be returned by closing time:\nNovember - March: 9AM - 5PM\nApril - October: 9AM - 7PM", "description_text": "", "description_bullets": "", "seo_description": "", "location": "1431 Ocean Ave Santa Monica, CA 90401", "booking_notes": "PICK UP LOCATION : Please look closely at the location that you picked in the booking.\n\n1431 Ocean Ave\nSanta Monica, CA 90401\n\nPlease be aware of our Store Hours, as bikes must be returned by closing time:\nNovember-March: 9AM - 5PM\nApril - October: 9AM - 7PM\n\nPlease bring along a valid form of identification and a credit card with you, as these will be needed for security upon check-in for your rentals. Your outfit should be seasonally suitable; we also suggest that you dress in something comfy, not too loose, and closed-toe shoes. Don't forget a proper ID and your camera!\n\nFor any questions, please feel free to reach our team at 212-749-4444. We'll see you soon!\n\nKnow Before You Go:\n\nYou must be at least 13 years old to ride an eBike in Santa Monica.\n\nAny riders under 18 years of age must have an adult present to check in and sign the waiver form in behalf of them. We require a valid identity card upon check in.\n\nFor all our riders' safety, we are not able to accommodate any riders who are 300 pounds and over as this exceeds the weight limit the manufacturer has advised for the bike's build. \n\nWe apologize for the inconvenience, but we do prioritize your safety during the ride.\n\nIf anything from the list above concerns you or any members of your party, please feel free to reach out to our team by responding to this email. We will get back to you as soon as we can!\n\n--------------------\n#SELF GUIDED TOUR APP:\nUnlimited Biking offers a self guided bike tour app for guests to download and use during their ride. Riders can choose the Highlights of Santa Monica & Venice Beach Bike Tour Route. This is a great tool for riders who want to ride at their own pace! This self-guided audio tool showcases the best historical/cultural sites, movie references, picture-worthy spots, and even accessible restrooms throughout your route! Click [here]([https://onelink.to/kjhg6u) to download onto your mobile app!\n\n![Description of image](https://cdn.filestackcontent.com/810ivRZhS71cXXeYm2gg)", "cancellation_notes": "Bike Rental Cancellation Policy\n\nPlease notify us at sales@unlimitedbiking.com at least 24 hours in advance if you cannot make your rental.\n\nFor any cancellations within 24 hours of the rental, we can provide a full credit in the amount you have paid that will never expire!\n\nPlease note: If you reschedule your booking for a later date, we must receive your cancellation request 24 hours before your original travel date. If you reschedule for an earlier date, the 24 hour cancellation window applies to your new travel date.", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/unlimitedbiking/items/394581/images/878295/", "pk": 878295, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/RDHucASly96tdZqO8bgi", "image_cdn_url": "https://cdn.filestackcontent.com/RDHucASly96tdZqO8bgi", "company": {"cls": "Company", "uri": "/api/v1/companies/unlimitedbiking/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/unlimitedbiking/items/394581/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/RDHucASly96tdZqO8bgi", "cropped_cdn_url": "https://cdn.filestackcontent.com/RDHucASly96tdZqO8bgi", "is_low_resolution": false, "has_text_overlay": false, "has_logo_overlay": false}, {"cls": "Image", "uri": "/api/v1/companies/unlimitedbiking/items/394581/images/878296/", "pk": 878296, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/FsO3FuKSIaZbpLrS6d4U", "image_cdn_url": "https://cdn.filestackcontent.com/FsO3FuKSIaZbpLrS6d4U", "company": {"cls": "Company", "uri": "/api/v1/companies/unlimitedbiking/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/unlimi