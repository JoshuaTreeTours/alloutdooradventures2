{"item": {"cls": "Item", "uri": "/api/v1/companies/floridaadventuresandrentals/items/76676/", "pk": 76676, "company": {"cls": "Company", "uri": "/api/v1/companies/floridaadventuresandrentals/", "pk": 13096, "shortname": "floridaadventuresandrentals", "name": "Florida Adventures and Rentals", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Private Dolphin Tours", "is_retail": false, "is_archived": false, "is_private": false, "color": 8, "unicode": "Private Dolphin Tours", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-midnight", "cutoff_unreached_hours": 3.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 0.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 3500, "description": "# VOTED #1 DOLPHIN TOUR ON MARCO ISLAND\n\n***Semi private Tours also available*** \n\n##Duration\n2 Hours\n\n##Dolphin Sightings Guaranteed\n\nWe guarantee dolphin sightseeing during this tour or your will get you money back. Dolphins are non-migratory which means they are in the area year-round and our captains are very familiar with where to find them.\n\n\n## About\nOn our 2 hour dolphin tour, we launch from the Goodland Boat Ramp, located at 750 Palm point Dr, Goodland, FL 34140. Our dolphin tours get you up close and personal with the majestic animals. See dolphins interact in their natural environment. Learn about the resident pods that live around Marco Island. This trip is not only fun, but educational for all ages. You are guaranteed to see dolphins on this tour. If we don’t see dolphins you get your money back! Manatees and over 150 different species birds are also very popular sights on our tours. This is a semi-private, or private boat tour with a maximum of 17 guests.\n\n\n## Departure Location\nWe depart from the Goodland Boat Ramp, located at 750 Palm Point Dr, Goodland, FL 34140. The Goodland Boat Park is a beautiful water access point that includes a 5.22 acre park, restrooms, concessions for sale from sunscreen to food and allows easy access to the Ten Thousand Islands and Gulf of Mexico.\n\n\n##Customizable\nOur Marco Island Dolphin tours are designed to accommodate everyone from individuals to groups of up to 17 people. Meet fellow adventurers and dolphin lovers or schedule a private boat tour for your group. We welcome individuals wanting to adventure on their own as well as large groups.", "description_text": "", "description_bullets": "", "seo_description": "", "location": "Goodland Boat Park", "booking_notes": "![Thank you for booking](https://cdn.filestackcontent.com/6HeSiQ6XQ2SGZN4lGJ7I)\n[![CLICK HERE FOR DIRECTIONS](https://cdn.filestackcontent.com/ggr7BmDWRneMAwYCoEPO)](https://www.google.com/maps/dir/25.955731,-81.7238755/GOODLAND+BOATING+PARK/@25.9391063,-81.7682825,12z/data=!3m1!4b1!4m9!4m8!1m1!4e1!1m5!1m1!1s0x88daf10a7e5f5a7b:0xd9efbd83fb662eaa!2m2!1d-81.6464898!2d25.9217576?entry=ttu)", "cancellation_notes": "Customers will receive a full refund if they cancel their reservation 48 hours prior to the date and time of their booking, (customers will be charged in full within the 48 hour period before the booking). Changes on your reservation will be received 48 hours in advance, otherwise your will be charged in full for your original booking. Contact us by phone to cancel or inquire about a cancellation. No-shows will be charged the full price. Customers will also receive a full refund in case of operator cancellation due to weather or other unforeseen circumstances. In the event that a tour operates for 50% of the scheduled time but must be cut short due to weather conditions for safety reasons, customers will receive a gift certificate for the remaining balance of the tour.", "no_transportation_notes": "", "no_transportation_minutes": 30, "headline": "2 hours • Boat tours up to 6 people or Groups up to 17 people.", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/floridaadventuresandrentals/items/76676/images/906062/", "pk": 906062, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/KDRotEB8RFSRppMNjQMa", "image_cdn_url": "https://cdn.filestackcontent.com/KDRotEB8RFSRppMNjQMa", "company": {"cls": "Company", "uri": "/api/v1/companies/floridaadventuresandrentals/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/floridaadventuresandrentals/items/76676/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/KDRotEB8RFSRppMNjQMa", "cropped_cdn_url": "https://cdn.filestackcontent.com/KDRotEB8RFSRppMNjQMa", "is_low_resolution": true, "has_text_overlay": false, "has_logo_overlay": false}, {"cls": "Image", "uri": "/api/v1/companies/floridaadventuresandrentals/items/76676/images/192764/", "pk": 192764, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/vBnvMaFzRHyWtIEPA0h3", "image_cdn_url": "https://cdn.filestackcontent.com/vBnvMaFzRHyWtIEPA0h3", "company": {"cls": "Company", "uri": "/api/v1/companies/floridaadventuresandrentals/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/floridaadventuresandrentals/items/76676/"}, "crop": {"y": 0, "x": 0, "width": 2500, "url": "https://cdn.filestackcontent.com/4tU5lTaTuSq5LM23MWEw", "height": 1315}, "cropped_url": "https://cdn.filestackcontent.com/4tU5lTaTuSq5LM23MWEw", "cropped_cdn_url": "https://cdn.filestackcontent.com/4tU5lTaTuSq5LM23MWEw", "is_low_resolution": false, "has_text_o