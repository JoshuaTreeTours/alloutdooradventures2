{"item": {"cls": "Item", "uri": "/api/v1/companies/fatherdaughtercharters/items/521577/", "pk": 521577, "company": {"cls": "Company", "uri": "/api/v1/companies/fatherdaughtercharters/", "pk": 88999, "shortname": "fatherdaughtercharters", "name": "Florida Sail", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Overnight Sail - 2 Nights", "is_retail": false, "is_archived": false, "is_private": false, "color": 2, "unicode": "Overnight Sail - 2 Nights", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-midnight", "cutoff_unreached_hours": 3.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 0.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 11000, "description": "Get ready for a relaxing two-night adventure from Treasure Island making stops at Egmont Key, Shell Key, and Anna Maria Island. This excursion gives you time to soak up the sun, experience the sailor's life, and unwind along the Gulf's picturesque coastline. With ample time for fishing, snorkeling, shell hunting, and exploring charming coastal towns, this trip promises to curate memories that will last a lifetime. Max: 6 Guests", "description_text": "", "description_bullets": "", "seo_description": "", "location": "Treasure Island", "booking_notes": "Thank you for choosing Florida Sail for your upcoming sailing adventure in Treasure Island! We are thrilled to have you on board, and want to ensure you have all information you need for a smooth and enjoyable experience. Please take note of the following details: \n\n### Booking Information: ###\nSailing Date: [Date]\nDeparture Time: [Time]\nDuration: 48 Hours\n\nLocation: \nDeparture Point:  6800 Sunshine Skyway Ln S, St Petersburg, FL 33711\n\nArrival Time: \nPlease plan to arrive at least 10 minutes before your scheduled departure. \n\nWhat to Bring: \nSwimwear\nSunscreen\nAppropriate layers\nAdditional food\nBeverages\nToiletries\n\nProvided for you: \nLinens\nTowels\nShampoo\nConditioner\nWater\nSoda\nCooler\nIce\n\nContact Information: If you need any assistance on the day of your sail, please contact us at the following phone number: 407-603-1483.", "cancellation_notes": "Embark on an unforgettable overnight sail, including a visit to historic Egmont Key, soaking in the sunset on the water, and anchoring near the charming Anna Maria Island. After a day of adventures, enjoy dinner and activities on the island before returning to Second Wind to rest. In the morning, have the option for an early morning coffee and breakfast on Anna Maria Island before starting our sail back to Treasure Island. Max: 6 Guests", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "3 Days/2 Nights Private Charter", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/fatherdaughtercharters/items/521577/images/1271632/", "pk": 1271632, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/j5GeS86dSJ69PBzITDHQ", "image_cdn_url": "https://cdn.filestackcontent.com/j5GeS86dSJ69PBzITDHQ", "company": {"cls": "Company", "uri": "/api/v1/companies/fatherdaughtercharters/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/fatherdaughtercharters/items/521577/"}, "crop": {"x": 0, "y": 207, "width": 2560, "height": 1347, "url": "https://cdn.filestackcontent.com/6aq8qIXT2WjqXkLQrcjc"}, "cropped_url": "https://cdn.filestackcontent.