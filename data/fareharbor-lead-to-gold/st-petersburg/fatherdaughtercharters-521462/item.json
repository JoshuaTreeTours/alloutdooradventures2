tails: \n\nLocation: \nDeparture Point:  6800 Sunshine Skyway Ln S, St Petersburg, FL 33711\n\nArrival Time: \nPlease plan to arrive no more than 10 minutes before your scheduled departure. \n\nWhat to Bring: \nSwimwear\nSunscreen\nAppropriate layers\nAdditional food\nBeverages\n\nProvided for you: \nTowels\nWater\nSoda\nCooler\nIce\n\nContact Information: If you need any assistance on the day of your sail, please contact us at the following phone number: 407-603-1483.", "cancellation_notes": "Customer Cancellation: Cancellations must be requested via call or email no less than 7 days before trip departure for a full refund. No shows will be charged full price. \n\nWeather Cancellations: If your trip's departure may be impacted by weather, our captains will reach out via text or email no less than 2hrs before departure with a weather update. Should the trip be canceled, guests are entitled to a full refund.", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "4 Hour Private Charter", "short_description": "", "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/fatherdaughtercharters/items/521462/images/1192288/", "pk": 1192288, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/Rft9qEmJSXKylnFORIKR", "image_cdn_url": "https://cdn.filestackcontent.com/Rft9qEmJSXKylnFORIKR", "company": {"cls": "Company", "uri": "/api/v1/companies/fatherdaughtercharters/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/fatherdaughtercharters/items/521462/"}, "crop": {"x": 0, "y": 411, "width": 1986, "height": 1045, "url": "https://cdn.filestackcontent.com/hkI4oKPdRVG1iTrE4MnD"}, "cropped_url": "https://cdn.filestackcontent.com/hkI4oKPdRVG1iTrE4MnD", "cropped_cdn_url": "https://cdn.filestackcontent.com/hkI4oKPdRVG1iTrE4MnD", "is_low_resolution": false, "has_text_overlay": false, "has_logo_overlay": false}, {"cls": "Image", "uri": "/api/v1/companies/fatherdaughtercharters/items/521