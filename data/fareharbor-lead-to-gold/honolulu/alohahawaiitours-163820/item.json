{"item": {"cls": "Item", "uri": "/api/v1/companies/alohahawaiitours/items/163820/", "pk": 163820, "company": {"cls": "Company", "uri": "/api/v1/companies/alohahawaiitours/", "pk": 466, "shortname": "alohahawaiitours", "name": "Aloha Hawaii Tours", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Pearl Harbor City Tour / USS Arizona Memorial", "is_retail": false, "is_archived": false, "is_private": false, "color": 1, "unicode": "Pearl Harbor City Tour / USS Arizona Memorial", "is_bookable_ever_by_phone": true, "sold_out_text": "Sorry! Looks like we are sold out.", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 17.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 0.75, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": -1500, "description": "Welcoming over a million visitors each year, Pearl Harbor easily takes first place as Oahu’s “must see” attraction. Immerse yourself in history and learn about “the day that will live in infamy” as you enjoy one of the country’s historical treasures.\n\n---\n#Tour Description:\nThis small group guided tour takes guests to the iconic USS Arizona Memorial at the Pearl Harbor’s Visitor’s Center. Guests have tickets for the world- famous USS Arizona Memorial where, on December 7, 1941, the surprise attack on Pearl Harbor by Japan violently propelled the United States into World War II. Our guests will experience the documentary film, the ferry to the memorial (weather permitting), see the black tears of the USS Arizona as well as have time to peruse the two museums and gift shop.\nFollowing Pearl Harbor our guests enjoy a city tour of Honolulu.\n\n#Tour Highlights:\n- Transportation to and from Pearl Harbor Visitors Center\n- Tickets for the boat ride to the USS Arizona Memorial\n- National Memorial Cemetery of the Pacific (Punchbowl)\n- The Hawaii State Capital\n- King Kamehameha Statue \n- ‘Iolani Palace (photo opportunity from King Kamehameha Statue)", "description_text": "", "description_bullets": "", "seo_description": "", "location": "Waikiki to Pearl Harbor, Oahu", "booking_notes": "**PLEASE NOTE** that our buses only pick up from Hotels in the Waikiki/Honolulu area.  If you are staying in a different area, contact us so that we can arrange for you to meet our driver. (808) 495-8693\n\n---------------\n\n### Please make sure that you are at your assigned pickup location at the time indicated on your voucher.\n\nIt is vital that we leave Waikiki on time in order to make it to Pearl Harbor on time for the USS Arizona Memorial Ticket times we have secured. Drivers will wait up to 5 minutes for late arrivals at each stop. Refunds are not given for no-shows, so please aim to arrive to your pickup location at least 10 minutes before your assigned pickup. \n\nPer US Navy Requirements, there are NO BAGS allowed within Pearl Harbor... This includes Camera Bags and Fanny Packs... There are lockers at the welcome center available for $5, but lines are often long, so it is best not to bring bags at all.  Bags cannot be left on the bus. \n\nIf you were given a paper voucher, please bring it with you. If you have an e-ticket, then you can show it to the driver from your phone.\n\nPlease allow a 10 min grace period on pick up times due to variable traffic in Waikiki.\n\nCancellations must be made at least 24 Hours before the activity start time, or no refund will be given.\n\nGeneral Excise Tax of 4.7% and 3% service fee will be added to the retail rate.\n\nThe reservations department may contact you to confirm your pickup information before your tour.  Please call us if you have any questions at (808) 495-8693\n\nMahalo!", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "", "short_description": "Step Back in Time: Discover Pearl Harbor and Honolulu’s WWII History", "image_url": "https://cdn.filestackcontent.com/T6HmzNNxSAu6KxpCM1Qy", "image_cdn_url": "https://cdn.filestackcontent.com/T6HmzNNxSAu6KxpCM1Qy", "images": [{"cls": "Image", "uri": "/api/v1/companies/alohahawaiitours/items/163820/images/1612982/", "pk": 1612982, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/o4szOc7TDOTnYYWc5Ycw", "image_cdn_url": "https://cdn.filestackcontent.com/o4szOc7TDOTnYYWc5Ycw", "company": {"cls": "Company", "uri": "/api/v1/companies/alohahawaiitours/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/alohahawaiitours/items/163820/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/o4szOc7TDOTnYYWc5Ycw", "cropped_cdn_url": "https://cdn.filestackcontent.com/o4szOc7TDOTnYYWc5Ycw", "is_low_resolution": true, "has_text_overlay": null, "has_logo_overlay": null}, {"cls": "Image", "uri": "/api/v1/companies/alohahawaiitours/items/163820/images/1322283/", "pk": 1322283, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/3FITLndfSoakiU32rgR7", "image_cdn_url": "https://cdn.filestackcontent.com/3FITLndfSoakiU32rgR7", "company": {"cls": "Company", "uri": "/api/v1/companies/alohahawaiitours/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/alohahawaiitours/items/163820/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/3FITLndfSoakiU32rgR7", "cropped_cdn_url": "https://cdn.filestackcontent.com/3FITLndfSoakiU32rgR7", "is_low_resolution": false, "has_text_overlay": false, "has_logo_overlay": false}, {"cls": "Image", "uri": "/api/v1/companies/alohahawai