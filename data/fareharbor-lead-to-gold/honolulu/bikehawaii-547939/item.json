{"item": {"cls": "Item", "uri": "/api/v1/companies/bikehawaii/items/547939/", "pk": 547939, "company": {"cls": "Company", "uri": "/api/v1/companies/bikehawaii/", "pk": 196, "shortname": "bikehawaii", "name": "Bike Hawaii", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Hawaii Volcanic Rainforest Hike", "is_retail": false, "is_archived": false, "is_private": false, "color": 4, "unicode": "Hawaii Volcanic Rainforest Hike", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-midnight", "cutoff_unreached_hours": 6.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-midnight", "cutoff_reached_hours": 4.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 3000, "description": "#Explore a volcano in the rainforest on this Oahu hike adventure!\n\n##Duration\n - Appx. - 3 hours\n - Monday and Friday\n\n##About \nExplore the Rainforest on our Hawaiian volcano / rainforest hiking adventure.\n\nTake a hiking trip along the slopes of an ancient cinder cone volcano and explore a lush native rainforest preserve offering sweeping views of O’ahu’s two parallel mountain ranges. Soak in majestic tropical island views as you hike to a 600-foot elevation gain. This Hawaii rainforest hiking trip is rich in rare and endemic plant species, your guided 2.5 mile moderate hike will meander through a native forest as it captures distant scenic views of both the highest point of the volcanic Ko’olau Mountain range (Konahuanui at 3150 feet), the highest point of O’ahu (Mt. Ka’ala at 4025 feet), Le’ahi (Diamond Head) volcano crater, Honolulu, Waikiki, Pearl Harbor, Kailua, and the shimmering Pacific Ocean.\n\nAbove average fitness level required for this 2.5 mile round-trip Hawaii volcano hike. Sturdy shoes with good traction on dirt and rainforest mud is a must.\n\nThis is family fun too! Even the kids will love it.", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "#WHAT'S INCLUDED\n - Professional nature guides\n - Rain poncho\n - Hip pack, mosquito repellent\n - Hiking poles\n - Boxed Waters and granola bars\n \n**Note:** Gratuities are not included. Suggested gratuity: 10% of tour price.\n\n#WHAT TO BRING\nPlease wear shoes suitable for hiking and bring sunscreen, snacks, water, camera, etc.", "cancellation_notes": "When booking this activity through a 3rd party, their cancellation policy applies. When booking direct, our cancellation policy is 24 hours before the tour. 50% within 24 hours and full charge for No Show.", "no_transportation_notes": "Please meet us at [Archie Baker Park](https://maps.app.goo.gl/hgz8eYy7kdvVcnqj7)", "no_transportation_minutes": 15, "headline": "All Ages  • Appx. 3 hours tour", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/bikehawaii/items/547939/images/1203047/", "pk": 1203047, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/LVnE4XMfTHKYIILh7VjM", "image_cdn_url": "https://cdn.filestackcontent.com/LVnE4XMfTHKYIILh7VjM", "company": {"cls": "Company", "uri": "/api/v1/companies/bikehawaii/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/bikehawaii/items/547939/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/LVnE4XMfTHKYIILh7VjM", "cropped_cdn_url": "https://cdn.filestackcontent.com/LVnE4XMfTHKYIILh7VjM", "is_low_resolution": true, "has_text_overlay": false, "has_logo_ov