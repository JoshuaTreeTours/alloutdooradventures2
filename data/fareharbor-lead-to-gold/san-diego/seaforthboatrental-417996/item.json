e you are within 72 hours, no changes or cancellations are permitted. Failure to show for reservation still incurs full rental rate and is not eligible for a refundor reschedule. As the renter, you are responsible for checking the weather forecast and making any desired changes at least 72 hours in advance.\t\t\t\n\n## What to bring\nPhoto ID for all drivers and credit card used for payment required for check in.", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "##What to bring\nPhoto ID for all drivers and credit card used for payment required for check in.", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "2 - 4 hour options", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/seaforthboatrental/items/417996/images/848308/", "pk": 848308, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/kETXdlSTEeXsyvt86zbp", "image_cdn_url": "https://cdn.filestackcontent.com/kETXdlSTEeXsyvt86zbp", "company": {"cls": "Company", "uri": "/api/v1/companies/seaforthboatrental/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/seaforthboatrental/items/417996/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/kETXdlSTEeXsyvt86zbp", "cropped_cdn_url": "https://cdn.filestackcontent.com/kETXdlSTEeXsyvt86zbp", "is_low_resolution": true, "has_text_overlay": false, "has_logo_overlay": false}], "created_at": "2022-11-01T15:55:27+0000", "modified_at": "2025-12-11T18:35:12+0000", "is_gratuity_enabled": false, "is_sms_reminder_enabled": false, "receipt_footer": "**Mission Bay - 619-223-1681**\n*In an emergency, hail coast guard on vhf 16 if equipped or call 911 on cell phone*\n\n**Rules and regulations for rental boats**\nThe following is a list of rules and regulations that does not include all rules, restrictions that may apply to the use and rental of this vessel. Instructions will be given verbally as well as in writing. ***Make sure you understand and ask questions before you go.***\n- Vessels must be returned prior to closing time\n- No one under 18 years old may operate the vessel\n- You may not operate the vessel if you are under the influence of alcohol or drugs\n- You must obey speed limits including idle speed rules in basins and marinas\n- You must obey right of way rules and restrictions imposed by gov’t agencies or u.S. Navy rules\n- You may not use the vessel for towing\n- In the event of unsafe conditions (weather, sea condition or vessel traffic), you shall proceed to a safe area and seek assistance.\n- The renter is responsible for the safety and conduct of his / her passengers and shall operate the vessel with this in mind at all times\n- You shall not approach any dock or pier until you and your crew are ready to safely secure the boat. You shall make sure all occupants are seated and they keep hands and feet in the boat while docking\n- Bow riding and teak surfing are strictly prohibited\n- You must obey all state, local, and federal rules regarding operation of boats\n- You shall not tie up to other boats while underway. You may not pick up additional passengers after departure\n- You may be subjected to fines and additional fees if you violate the above rules", "is_scanning_enabled": false, "scanning_instructions": "", "external_url": "", "effective_pre_checkout_flow_node": null, "effective_post_checkout_flow_node": null, "settings": {"is_booking_fee_only": false, "is_booking_hold_capacity_enabled": false, "is_price_estimate_hidden": false, "is_item_abandoned_cart_enabled": true, "email_restriction": "", "is_seating_confirmations_enabled": false, "is_online_seating_enabled": false, "is_include_pending_in_live_capacity_enabled": false, "is_advanced_online_seating_enabled": false, "is_always_show_customer_counts": false, "is_online_installments_enabled": true, "is_online_booking_online_installments_en