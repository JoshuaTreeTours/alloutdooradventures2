{"item": {"cls": "Item", "uri": "/api/v1/companies/paradisepointsandiego/items/322965/", "pk": 322965, "company": {"cls": "Company", "uri": "/api/v1/companies/paradisepointsandiego/", "pk": 35607, "shortname": "paradisepointsandiego", "name": "Paradise Point Resort & Spa - San Diego", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Island Yoga with Meditation", "is_retail": false, "is_archived": false, "is_private": false, "color": 11, "unicode": "Island Yoga with Meditation", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 1.0, "is_cutoff_unreached_call_to_book": false, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 0.0, "is_cutoff_reached_call_to_book": false, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 875, "description": "#*Ground yourself in meditation and yoga!*\n___________________________________\n## Times Available \nSundays at 10:00 AM\n__________\n## Location\nParadise Terrace (unless otherwise notified)\n__________\n## Rates\n**Guest (Ages 13+):** Complimentary\n**Non-Guests (Locals):** $16 per class \n___________________________________\n## Duration\n1 Hour\n___________________________________\n## About\nStart your Sunday off right with a little self-care! Relax your body and mind in this 50-minute replenishing yoga class paired with a short meditation and breathwork. Designed as a meditation in motion, we’ll slow down, stretch the whole body and calm the nervous system to restore a state of balance. Expect to flow with intention and grace, reconnect to the self and cultivate mindfulness. Suitable for all levels!\n\n_____\n##  About your Paradise Yoga Teacher Margy Rose:\n\nOriginally from Portland, Maine, Margy settled in San Diego after living in Costa Rica for five years. She began practicing yoga in 2009 and lives to share this empowering practice with others. In each of Margy’s classes you can expect a full-body, expansive flow, with breathwork, gratitude and mindfulness practices woven in. She believes that yoga offers an opportunity for transformation, both in body and mind, and encourages her students to take the lessons learned on the mat out into the world for a fuller, more exceptional life.\nAlso an empowerment coach, when not teaching yoga you can find Margy supporting women to step into their full potential or doing something outdoorsy or on an adventure.\n\n_____", "description_text": "", "description_bullets": "", "seo_description": "", "location": "Paradise Terrace", "booking_notes": "You're all set! Head over to the Paradise Terrace at the schedule date/time to meet your instructor. Personal mats are recommended, however they are included. \n\nPlease arrive 15 minutes prior to sign the waiver and settle into your spot.", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "Complimentary for Resort Guests | Sun | 10am", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/paradisepointsandiego/items/322965/images/952187/", "pk": 952187, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/qN99Ym93Qs6ahlSDq2rI", "image_cdn_url": "https://cdn.filestackcontent.com/qN99Ym93Qs6ahlSDq2rI", "company": {"cls": "Company", "uri": "/api/v1/companies/paradisepointsandiego/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/paradisepointsandiego/items/322965/"}, "crop": {}, "cropped_url": "https://c