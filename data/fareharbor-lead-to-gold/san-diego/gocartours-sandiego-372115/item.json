{"item": {"cls": "Item", "uri": "/api/v1/companies/gocartours-sandiego/items/372115/", "pk": 372115, "company": {"cls": "Company", "uri": "/api/v1/companies/gocartours-sandiego/", "pk": 32820, "shortname": "gocartours-sandiego", "name": "GoCar Tours San Diego", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "GoCar After Dark - 2HR Coronado Tour", "is_retail": false, "is_archived": false, "is_private": false, "color": 12, "unicode": "GoCar After Dark - 2HR Coronado Tour", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 1.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 0.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 9968, "description": "Take a nighttime adventure of a lifetime to California's crown jewel, Coronado Island in the brand new electric go car! Starting downtown you will get to drive through and see all the city lights. Then cross over the famous Coronado bridge and take in the unbeatable views of the city at night. Take a tour around Coronado in our GPS self navigating electric go car and then make your way back to the gaslamp quarter! This tour is unique because you'll be able to see some of the best sights lit up while going over the Coronado bridge, plus even parts of Tijuana!\n\n**Conditions:**\n\n- GoCars hold a maximum of 2 people. Prices are per GoCar, not per person.\n- Must be 21 years or older to rent. Must possess a major credit card and valid driver’s license (international license is not necessary). GoCars do not accommodate car seats for children.\n- On the day of rental, a security deposit will be held on your credit card until the GoCar is returned. All riders must sign a standard participant agreement. Renters will have the option to purchase Collision Damage Waiver (CDW) insurance on the day of rental.\n- Renters are free to extend the length of their tour on the day of rental. Additional rental time will be charged in 15-minute increments.\"", "description_text": "", "description_bullets": "", "seo_description": "", "location": "3918 Mason Street, San Diego, CA 92110", "booking_notes": "##Driver must be 21 years or older with a valid driver's license.\n\n##Please arrive at least 15 min before your scheduled departure time. \n\n-Parking is difficult in  San Diego sometimes so we always suggest taking an Uber or Lyft.\n\n-Departure times are approximated due to customers prior to your reservation possibly taking longer than they were booked for.\n\n- If you wish to keep your car longer than what you have booked for, you are welcome, but please check that it is available for you to keep and not needed by another renter. \n\n- Additional time is charged in 15 minute increments at our standard internet rates. \n\n- Please make sure you return the car before we close. Late returns are billed at $1 per minute. Please check with staff on day of rental the close time of the location. Early returns will not be refunded for unused time.", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "City Lights Tour from Gaslamp to Coronado Island", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/gocartours-sandiego/items/372115/images/776471/", "pk": 776471, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/vEcXKTAJS