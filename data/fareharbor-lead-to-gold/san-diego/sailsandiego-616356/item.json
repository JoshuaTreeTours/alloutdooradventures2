{"item": {"cls": "Item", "uri": "/api/v1/companies/sailsandiego/items/616356/", "pk": 616356, "company": {"cls": "Company", "uri": "/api/v1/companies/sailsandiego/", "pk": 105484, "shortname": "sailsandiego", "name": "Sail San Diego", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Private Sailing Yacht: 1-14 Guests", "is_retail": false, "is_archived": false, "is_private": false, "color": 12, "unicode": "Private Sailing Yacht: 1-14 Guests", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 24.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 24.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": 1, "maximum_subsequent_party_size": 1, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": true, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 37000, "description": "", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "---\t\n**We genuinely care about your overall experience from start to finish so please continue reading all the information below:**\n\n**BEFORE ARRIVAL:**\nPlease have every guest sign our sailing waiver prior to your arrival. The waivers are all digital so no need to print anything out. Don't stress if you're having too much difficulty with them, as you can always sign when checking in at our office location.\n\n**CHECK-IN:**\nPlease check in at our office 20-30 minutes before the departure time. A physical boarding pass will be required to board your assigned sailboat. Your boarding pass will be provided at our Sail San Diego office, located at 2720 Shelter Island Drive, San Diego, California 92106.\n\nYou will find us on the corner of the first floor across the street from the Brigantine Restaurant and next to All Aboard.\n\nAfter receiving your boarding pass, you will be directed to our private marina for boarding. We will open gates 10 minutes prior to the departure time.\n\n**PARKING:**\nSan Diego hosts 32 million visitors annually, making parking especially limited during summer. We recommend arriving at least 30 minutes early to find parking or using Lyft.\n\nIf using Uber, please ensure you enter our address directly. Do not enter \"Sail San Diego,\" as this will direct the driver to our old location from eight years ago, which is about half a mile away.\n\n[CLICK HERE TO VIEW OUR DIRECTIONS PAGE](https://sailsandiego.com/contact/)\n\n**PROHIBITED ITEMS:**\nNO SMOKING OR OUTSIDE ALCOHOLIC BEVERAGES ALLOWED ON THIS CHARTER.\n\nAsk about our onboard bar package for a selection of beers, hard seltzers, and wines available as an optional add-on to elevate your sailing experience. And feel free to bring your own food & snacks on board, but remember, you're on a sailboat. Hand-held foods are recommended. \n\nWe are a federally regulated business and drugs are strictly prohibited (including Marijuana) while underway or at the marina. Vessel will return to the dock and Harbor Police will be called if the Captain sees or smells Marijuana. **NO EXCEPTIONS!**\n\nFrom your Captains and Crew at Sail San Diego,\n\nFair Winds and Following Seas", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "Includes Captain & Crew • All Ages Welcome", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/sailsandiego/items/616356/images/1654460/", "pk": 1654460, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/dNE806StR6mch43vpkYo", "imag