{"item": {"cls": "Item", "uri": "/api/v1/companies/legacycruisessd/items/324726/", "pk": 324726, "company": {"cls": "Company", "uri": "/api/v1/companies/legacycruisessd/", "pk": 73369, "shortname": "legacycruisessd", "name": "Legacy Cruises and Events", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Private Yacht Charter on the Sirara", "is_retail": false, "is_archived": false, "is_private": true, "color": 1, "unicode": "Private Yacht Charter on the Sirara", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 48.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 48.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": true, "is_grouped_calendar": true, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 1000, "description": "#San Diego's Most Elegant Private Yacht Charter\n\n##About Us\nLegacy Cruises and Events is proud to offer the Sirara, a one-of-a-kind cruising vessel for hosting events on the serene waters of beautiful San Diego Bay. We offer this classic, newly renovated, luxury commercial yacht for your event, setting sail around the Bay, providing – together with our partners superb all-encompassing personalized services and exclusive first-class experiences to make your special day or evening unforgettably spectacular.\n\n##About the Yacht\n- Custom-built 65 foot luxury cruising yacht, US Coast Guard certified for up to 120 passengers\n- Totally renovated and enhanced this year to give you the feeling of a totally new boat while retaining its classic design and innovative architecture\n- Over 1,500 square feet of entertainment space on two decks with newly-constructed upscale amenities\n- Lower enclosed main deck, with flexible seating arrangement, open social/dance ﬂoor, two luxury restrooms and a full bar\n- Top open deck with expansive 360 degree views of San Diego Bay along with an exclusive VIP area\n- Fully customizable LED lighting throughout the interior and exterior of the yacht\n- Integrated state of the art multimedia system for DJ and live music entertainment.\n\n##Duration\n- 3 - 4 Hours \n- Up to 85 Guests", "description_text": "", "description_bullets": "", "seo_description": "", "location": "San Diego Bay", "booking_notes": "Thank you again for hosting your event with us on the luxury yacht Sirara. We are looking forward to welcoming you and your party aboard!\n\nYou will be receiving the following items from us prior to the date of your charter:\n\n1. An online version of our charter contract/waiver to electronically sign. This is sent from **noreply@signwell.com**. Please add email address this to your safe senders list to make sure you receive it. You can also access, view and sign the agreement online via the following direct link: **https://waiver.smartwaiver.com/v/sirara/**\n2. About a week prior to the date of your charter, you will receive an email with detailed logistics, including a link to a customized registration page for you and your guests to check in and be entered on the manifest. **Please add team@legacycruisessd.com to your safe senders list in your email account settings**\n\nPlease be on the lookout for the above, and let us know at team@legacycruisessd.com if you don't receive them.", "cancellation_notes": "At Legacy Cruises and Events, we value flexibility and understand that plans can change. Our cancellation policy requires a non-refundable deposit to reserve your charter, with a 10% cancellation fee if you cancel more than 30 days prior to the event. For cancellations less than 30 days before the charter, 30% of the total cost is retained. Unfortunately, cancellations within 10 days of the event, as well as no-shows or being over 30 minutes late without communication, will not be eligible for a refund due to the challenges in re-booking. However, in the rare instance that we cancel the charter due to a weather advisory from the United States Coast Guard, a full refund will be provided. All cancellations must be communicated via email for proper documentation. This policy ensures we can continue offering high-quality, memorable experiences while accommodating your needs as best as possible.", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "Starting at $1,200/hour • San Diego's Most Elegant Yacht Charter • 10% Deposit Available!", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/legacycruisessd/items/324726/images/621523/", "pk": 621523, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/IsKPfJQMy5nOoRFKx9Ng", "image_cdn_url": "https://cdn.filestackcontent.com/IsKPfJQMy5nOoRFKx9Ng", "company": {"cls": "Company", "uri": "/api/v1/companies/legacycruisessd/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/legacycruisessd/items/324726/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/IsKPfJQMy5nOoRFKx9Ng", "cropped_cdn_url": "https://cdn.filestackcontent.com/IsKPfJQMy5nOoRFKx9Ng", "is_low_resolution": true, "has_text_overlay": false, "has_logo_overlay": false}, {"cls": "Image", "uri": "/api/v1/companies/legacycruisessd/items/324726/images/854733/", "pk": 854733, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/FyUhQTfyRDCf3YoxXEBv", "image_cdn_url": "https://cdn.filestackcontent.com/FyUhQTfyRDCf3YoxXEBv", "company": {"cls": "Company", "uri": "/api/v1/companies/legacycruisessd/"}, "item": {"cls": "Item", "ur