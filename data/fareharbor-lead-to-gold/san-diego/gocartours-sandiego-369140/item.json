{"item": {"cls": "Item", "uri": "/api/v1/companies/gocartours-sandiego/items/369140/", "pk": 369140, "company": {"cls": "Company", "uri": "/api/v1/companies/gocartours-sandiego/", "pk": 32820, "shortname": "gocartours-sandiego", "name": "GoCar Tours San Diego", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "2 Hr. GoCar Coronado Tour", "is_retail": false, "is_archived": false, "is_private": false, "color": 10, "unicode": "2 Hr. GoCar Coronado Tour", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 1.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 0.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 42000, "description": "Experience this 1-hour tour in our brand new GoCar  by Arcimoto. Experience this open-air adventure with the silence of an electric motor. Top Speed 75mph. Cover more ground and be green while exploring San Diego!\n\nThis tour is for anyone that wants to discover California's Crown Jewel, Coronado Island. You will start Downtown where you will explore the Gaslamp quarter, USS Midway, and Seaport Village. Then explore Coronado's pristine beaches, the famous Hotel del Coronado, the Ferry Landing, shops, and much more. As you enjoy the drive our GoCar will take you to all the best sites, recommends restaurants, cracks jokes, and tells the stories that bring a destination to life. See the visually stunning Coronado Bay Bridge and the San Diego Harbor as you make your way across. Driving over the Coronado Bridge, you will get to see the best views of San Diego. Make your way through Downtown Coronado where you'll hear all about Coronado Island's rich history. Drive along the beaches and pass by the Naval Air Station on North Island. Don't miss out on one of our most unique tours!", "description_text": "", "description_bullets": "", "seo_description": "", "location": "3918 Mason Street, San Diego, CA 92110", "booking_notes": "##Please arrive at least 15 min before your scheduled departure time. \n\n-Parking is difficult in downtown San Diego sometimes so we always suggest taking an Uber or Lyft.\n\n-Departure times are approximated due to customers prior to your reservation possibly taking longer than they were booked for.\n\n- If you wish to keep your car longer than what you have booked for, you are welcome, but please check that it is available for you to keep and not needed by another renter. \n\n- Additional time is charged in 15 minute increments at our standard internet rates. \n\n- Please make sure you return the car before we close. Late returns are billed at $1 per minute. Please check with staff on day of rental the close time of the location. Early returns will not be refunded for unused time.", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/gocartours-sandiego/items/369140/images/726585/", "pk": 726585, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/K6NhXGrSn60WWrBcWwxc", "image_cdn_url": "https://cdn.filestackcontent.com/K6NhXGrSn60WWrBcWwxc", "company": {"cls": "Company", "uri": "/api/v1/companies/gocartours-sandiego/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/gocartours-sandiego/items/369140/"}, "crop": {}, "cropped_url": "https://cdn.fi