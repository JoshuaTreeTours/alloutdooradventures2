{"item": {"cls": "Item", "uri": "/api/v1/companies/justgetwet/items/556020/", "pk": 556020, "company": {"cls": "Company", "uri": "/api/v1/companies/justgetwet/", "pk": 90304, "shortname": "justgetwet", "name": "Just Get Wet", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Spearfishing Shore Tour", "is_retail": false, "is_archived": false, "is_private": false, "color": 7, "unicode": "Spearfishing Shore Tour", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-midnight", "cutoff_unreached_hours": 3.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 0.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 2, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 48000, "description": "Experience the Pacific Ocean from Shore!  We will pair you up with one of our experienced spearfishing guides who have been trained in freediving and spearfishing safety, to teach you the fundamentals of spearfishing in southern California. In this tour we will cover breath holding and freediving techniques, the importance of the buddy system, proper use of a pole spear, fish identification, California fishing regulations, how to attract fish, how to properly preserve your catch, and much more.\n\n##Itinerary\nWe will meet either in La Jolla or Point Loma at 11am based on current conditions.  We will go through a pre dive briefing where you will learn breath hold techniques that will improve your bottom time and surprise you with what you're capable of! After that we will head out to the kelp forests to work on diving technique, fish identification, hunting techniques, and spear some fish! \n\n##Requirements\n- California fishing license \n- Wetsuit (A 5mm open cell spearfishing wetsuit is highly recommended)\n- Mask / Snorkel \n- Gloves / Booties\n- Dive Knife\n- Fins\n- Weight Belt / Weights \n\nGear is available for rent from the shop\nMinimum 2 people to run the tour\nMust book at least 24hrs in advance", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "Thank you for booking this tour! \n\nItinerary: \nWe will meet either in La Jolla or Point Loma at 11am based on current conditions.  We will go through a pre dive briefing where you will learn breath hold techniques that will improve your bottom time and surprise you with what you're capable of! After that we will head out to the kelp forests to work on diving technique, fish identification, hunting techniques, and spear some fish! \n\nRequired:\n\nCalifornia fishing license \nWetsuit (A 5mm open cell spearfishing wetsuit is highly recommended)\nMask / Snorkel \nGloves / Booties\nDive Knife\nFish Stringer\nFins\nWeight Belt / Weights \n*All gear can be rented through the shop if needed and picked up before the session at our headquarters in Mission Beach*\n\n**Must book at least 24 hours before selected date**\n\n*** 2 person minimum to run tour***\n\n**Preparation:**\n\nMake sure you hydrate the night before and day of, and definitely bring some liquids with you on the boat. If you are prone to motion sickness we highly recommend taking medication such as dramamine starting the night before. It’s extremely affordable, and there’s nothing worse than being sick the whole time you’re out on the water. This is the best, most effective, and cheapest trip insurance you can buy!\n\nThis trip is dependent on conditions. While the summer months are usually predictable and mellow, excessive wind or swell events still can happen and we reserve the right to cancel the trip. We will inform you a few days ahead of time if the conditions are looking iffy, and make the final call the day before. If we cancel due to weather you will get a full refund.\n\nIf there are any other questions or concerns please email us at **info@justgetwet.com** and we will be sure to answer all your questions! Looking forward to getting out there with you.\n\nCheers\n\nThe Just Get Wet Crew", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/justgetwet/items/556020/images/1226394/", "pk": 1226394, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/suvL2lciS9gQyjWejqoA", "image_cdn_url": "https://cdn.filestackcontent.com/suvL2lciS9gQyjWejqoA", "company": {"cls": "Company", "uri": "/api/v1/companies/justgetwet/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/justgetwet/items/556020/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/suvL2lciS9gQyjWejqoA", "cropped_cdn_url": "https://cdn.filestackcontent.com/suvL2lciS9gQyjWejqoA", "is_low_resolution": false, "has_text_overlay": false, "has_logo_overlay": false}], "created_at": "2024-06-11T17:51:46+0000", "modified_at": "2024-06-11T18:13:58+0000", "is_gratuity_enabled": false, "is_sms_reminder_enabled": false, "receipt_footer": "", "is_scanning_enabled": false, "scanning_instructions": "", "external_url": "", "effective_pre_checkout_flow_node": {"cls": "FlowNode", "uri": "/api/v1/companies/justgetwet/flow-nodes/852099/", "pk": 852099, "unicode": "Suggested Item - Rental Gear", "company": {"cls": "Company", "uri": "/api/v1/companies/justgetwet/"}, "name": "Suggested Item - Rental Gear", "short_name": "", "sortable_index": 25000, "is_rental": false}, "effective_post_checkout_flow_node": {"cls": "FlowNode", "uri": "/api/v1/co