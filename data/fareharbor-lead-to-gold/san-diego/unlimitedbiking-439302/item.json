{"item": {"cls": "Item", "uri": "/api/v1/companies/unlimitedbiking/items/439302/", "pk": 439302, "company": {"cls": "Company", "uri": "/api/v1/companies/unlimitedbiking/", "pk": 5980, "shortname": "unlimitedbiking", "name": "Unlimited Biking", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Best of San Diego eBike Tour", "is_retail": false, "is_archived": false, "is_private": false, "color": 6, "unicode": "Best of San Diego eBike Tour", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-midnight", "cutoff_unreached_hours": 3.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": -2.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": true, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 280000, "description": "Join us for a 2.5 hour guided electric bike tour around the stunning city of San Diego. Beginning from our store location, the first stop on this leisurely tour is the historic Gaslamp Quarter, established in the 1860s and redeveloped in the 1980s. From there, you’ll ride your pedal assist eBikes to the San Diego Bay, where you’ll learn the history of the USS Midway, Billionaire Row, and The Bob Hope Memorial. Our licensed tour guides will then lead you through Balboa Park, measuring just under five kilometers or 1,200 acres. In Balboa Park, you will ride past and learn about the San Diego Zoo, the Spanish Village Art Center, and the famous Casa de Balboa. This city is perfect for animal lovers, beach enthusiasts, and outdoorsy folks! Our guides are happy to take plenty of pictures for you so you can cherish the memories. The tour ends back at our store location on K Street.\n\nPlease note: there will be a good deal of street riding on this tour. Guests must be 16+ to ride an electric bike. We cannot attach baby seats or trailers to eBikes.", "description_text": "", "description_bullets": "", "seo_description": "", "location": "330 K Street San Diego, CA 92101", "booking_notes": "PICK UP LOCATION : \n\n330 K Street\nSan Diego, CA 92101\n\nThis tour begins at 10AM. Please plan to arrive 15 minutes early as the tour does leave on time. Let our team know if you are running late. \n\nOur Store Hours are: 9AM - 7PM\n\nPlease bring along a valid form of identification and a credit card with you, as these will be needed for security upon check-in for your rentals. Your outfit should be seasonally suitable; we also suggest that you dress in something comfy, not too loose, and closed-toe shoes. Don't forget a proper ID and your camera!\n\n**Know Before You Go:**\n\n-We do not allow child attachments on eBikes for safety reasons.\n-Riders must be at least 16 years old to ride eBikes\n-Hybrid bikes are not permitted on this tour\n-Any riders under 18 years of age must have an adult present to check in and sign the waiver form on their behalf. We require a valid identity card upon check in.\n-For all our riders' safety, we are not able to accommodate any riders who are 300 pounds and over as this exceeds the weight limit the manufacturer has advised for the bike's build. We apologize for the inconvenience, but we do prioritize your safety during the ride. \n\nIf anything from the list above concerns you or any members of your party, please feel free to reach out to our team by responding to this email. We will get back to you as soon as we can!\n\nFor any questions, please feel free to reach our team at 212-749-4444. We'll see you soon!", "cancellation_notes": "**Bike Tour Cancellation Policy**\n\nPlease notify us at sales@unlimitedbiking.com at least 24 hours in advance if you cannot make your rental.  \n\nFor any cancellations within 24 hours of the rental, we can provide a full credit in the amount you have paid that will never expire!\n\nPlease note: If you reschedule your booking for a later date, we must receive your cancellation request 24 hours before your original travel date. If you reschedule for an earlier date, the 24 hour cancellation window applies to your new travel date.", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "Explore the best of San Diego on this Guided eBike Ride", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/unlimitedbiking/items/439302/images/944084/", "pk": 944084, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/m192tskPQ0KwAEsoQK52", "image_cdn_url": "https://cdn.filestackcontent.com/m192tskPQ0KwAEsoQK52", "company": {"cls": "Company", "uri": "/api/v1/companies/unlimitedbiking/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/unlimitedbiking/items/439302/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/m192tskPQ0KwAEsoQK52", "cropped_cdn_url": "https://cdn.filestackcontent.com/m192tskPQ0KwAEsoQK52", "is_low_resolution": false, "has_text_overlay": false, "has_logo_overlay": false}, {"cls": "Image", "uri": "/api/v1/companies/unlimitedbiking/items/439302/images/903155/", "pk": 903155, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/VuMAGFqMRVGhk6PuGx1t", "image_cdn_url": "https://cdn.filestackcontent.com/VuMAGFqMRVGhk6PuGx1t", "company": {"cls": "Company", "uri": "/api/v1/companies/unlimitedbiking/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/unlimitedbiking/items/439302/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/VuMAGFqMRVGhk6PuGx1t", "cropped_cdn_url": "https://cdn.filestackcontent.com/VuMAG