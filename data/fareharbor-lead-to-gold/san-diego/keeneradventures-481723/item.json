{"item": {"cls": "Item", "uri": "/api/v1/companies/keeneradventures/items/481723/", "pk": 481723, "company": {"cls": "Company", "uri": "/api/v1/companies/keeneradventures/", "pk": 95826, "shortname": "keeneradventures", "name": "Keener Adventures LLC.", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "San Diego Bay - High‑Speed History & Sea Lion Discovery Tour", "is_retail": false, "is_archived": false, "is_private": false, "color": 9, "unicode": "San Diego Bay - High‑Speed History & Sea Lion Discovery Tour", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 72.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 72.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": true, "is_unlisted": false, "booking_restriction": {"cls": "BookingRestriction", "uri": "/api/v1/companies/keeneradventures/booking-restrictions/9817/", "pk": 9817, "unicode": "3 days out requirement", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 72.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 72.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": true, "company": {"cls": "Company", "uri": "/api/v1/companies/keeneradventures/"}, "name": "3 days out requirement"}, "is_card_required": true, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 2812, "description": "##Duration\t\t\t\t\t\n1-2 Hours, depending on what you would like to see\n\n##About\nWe offer two exciting options. Depending on whether or not you would like to see just sea lions up close and personal (Not too close, though), we will take you on a fantastic day trip.\n\n### One-Hour Trip - Sea Lion Viewing\nOur one-hour excursion allowed you to go out with our captains, who will give you a unique experience. View California Sea Lions in their natural habitat as they swim and play around. See what makes them different from regular harbor seals and why they called San Diego Bay their home. \n\n### Two-Hour Trip - Down Town and the Coronado Bay Bridge\nAlong with seeing Sea Lions, similar to the one-hour cruise, you will also take a high-speed ride down the bay to see the Coronado Bay Bridge, the Fly Navy sign, the USS Midway Aircraft Carrier Museum, the San Diego Maritime Museum, and more. See more on a longer cruise and enjoy its high speeds.\n\n##What to Bring\t\t\t\t\t\nBring a camera or fully charged phone to take photos and videos. We bring small snacks, but you and your party are always welcome to bring your food and drinks onboard. Please remember that Glass is not allowed on our cruises at any time.\n\n*Please remember that you will be on a boat that may rock back and forth. When bringing food and drink to the cruise, please keep this in mind.\n\n##What's Included with your cruise (Other than the tour)\n- Rental Boat\n- US Coast Guard Certified Captain\n- A Complementary Bluetooth Speaker for you and your guests to use onboard\n- Complementary water and small snacks for you and your group to enjoy onboard\n\nGuest of the Kona Kai San Diego? [Click Here To Make your Reservation](https://www.resortkonakai.com/local-experiences/#!/e/san-diego-bay-private-tour-5eae1064) and get up to $100 off your cruise and more.", "description_text": "", "description_bullets": "", "seo_description": "", "location": "1551 Shelter Island Dr, San Diego, CA 92106", "booking_notes": "We look forward to you joining us!\n---\nWe know you are excited to go on your adventure, but before you do, we want to ensure we go over a few essential things that will help make your adventure so much more fun.\n\n##Things to know before arrival\n\n1) Please ensure a Waiver has been filled out for everyone attending the activity.\n2) Please make sure you show up 10 minutes before departure. We depart on time so that everyone can enjoy the most out of the cruise.\n\n*If you have any questions or concerns, please do not hesitate to contact us via email at ahoy@keeneradventures.com or by text/call/Whatsapp at +1(619)350-3258.\n\n---\n\n##Gratuity\n\nOur Captains and/or Crew work hard to ensure you and your party have an outstanding time on the water. If you would like to thank them with a little extra, we highly encourage it. The typical gratuity is 20% of the total cost of the ticket, but you can tip however much or little you feel is appropriate. This is, of course, optional and is never required.", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "", "short_description": "A fast, fun, and photo‑ready adventure on San Diego Bay", "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/keeneradventures/items/481723/images/1824528/", "pk": 1824528, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/grIrg67mTEKEnb4YBZn3", "image_cdn_url": "https://cdn.filestackcontent.com/grIrg67mTEKEnb4YBZn3", "company": {"cls": "Company", "uri": "/api/v1/companies/keeneradventures/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/keeneradventures/items/481723/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/grIrg67mTEKEnb4YBZn3", "cropped_cdn_ur