{"item": {"cls": "Item", "uri": "/api/v1/companies/joshuatreeexcursions/items/459590/", "pk": 459590, "company": {"cls": "Company", "uri": "/api/v1/companies/joshuatreeexcursions/", "pk": 97490, "shortname": "joshuatreeexcursions", "name": "Joshua Tree Excursions", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Private Sunset Hike", "is_retail": false, "is_archived": false, "is_private": false, "color": 11, "unicode": "Private Sunset Hike", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 168.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 168.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 1750, "description": "#Hike into the sunset. \t\n \t\t\t\t\t\t\t\t\t\t\t\n\n##Duration \n6 hours\n\n##About\n You can choose to meet at our office, be picked up locally or request transportation from Coachella Valley cities. Your guide will then take you on a drive through the most incredible parts of the park, on-route to your hike/Sightseeing for the day. From your trailhead, your guide will lead you on a mostly off-trail adventure of 1-6 miles, through the Joshua Tree wilderness. Towering rock formations, canyons, sweeping vistas, and surreal landscapes from another planet await you around every bend. Enjoy an optional lunch on the trail before continuing your journey. All along the way, your expert guide will share the history and geology of the Park, along with a myriad of stories and talks about the plants, animals, and other unique characteristics of the Park. You may even get in some epic rock scrambling to the top of some of our famous rock formations for views and experiences rarely had by others. At the conclusion of your hike, time permitting, your guide will get you to some of the other popular sights in the park before returning you safely to our office or back to your lodging facility where you can relax and talk about the memories that you have made, that will last a lifetime. \t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n##What's Included\n- Pick up and drop off from our office in Joshua Tree\n - All park fees\n- Water\n- Transportation in & around the park\n- An optional lunch on the trail (additional fees apply)\n- A loaner daypack.\n\n##Not included: \n- Additional equipment \n- 15-20% customary gratuity\n\n**For groups of 8 or more please call.**", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "All Ages! • 6 Hours • Up to 7 people", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/joshuatreeexcursions/items/459590/images/956685/", "pk": 956685, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/DNm8050SkSrT6n4nlCPu", "image_cdn_url": "https://cdn.filestackcontent.com/DNm8050SkSrT6n4nlCPu", "company": {"cls": "Company", "uri": "/api/v1/companies/joshuatreeexcursions/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/joshuatreeexcursions/items/459590/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/DNm8050SkSrT6n4nlCPu", "cropped_cdn_url": "https://cdn.filestackcontent.com/DNm8050SkSrT6n4nlCPu", "is_low_resolution": true, "has_text_overlay": false, "has_logo_overlay": false}], "created_