{"item": {"cls": "Item", "uri": "/api/v1/companies/jobsurfexperience-sd/items/648512/", "pk": 648512, "company": {"cls": "Company", "uri": "/api/v1/companies/jobsurfexperience-sd/", "pk": 96625, "shortname": "jobsurfexperience-sd", "name": "Jamie O’Brien Surf Experience - San Diego", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Del Club Members Daily Group Surf Lesson", "is_retail": false, "is_archived": false, "is_private": false, "color": 3, "unicode": "Del Club Members Daily Group Surf Lesson", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-midnight", "cutoff_unreached_hours": 3.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 0.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": true, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": true, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 4250, "description": "#Hit the waves and make some friends!\n\n##Times and Durations\n- Daily \n- 1.5 Hours\n\n##About\nThis experience is for those who don’t mind sharing their waves and psych with a small group of new friends.", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "#We're out there!\n\nMany guests ask us if their experience or lesson will be taught and/or guided by Jamie O'Brien, and while Jamie does own and operate our surf school, he does not teach or guide himself. However, every instructor and guide has been hand selected by Jamie to provide you the safest and best experience possible, and they are eagerly waiting to get you in the water.\n\nAll equipment needed for experience is provided, including Surfboard/SUP Board, Wetsuit, and Leash.\n\nPlease be advised that if you book the Group Surf Lesson and no one else signs up to surf with you in your scheduled group you will be asked to join another group at a different day or time where other surfers are already signed up. If you wish to proceed with your scheduled lesson time, you will need to upgrade to a private 1:1 lesson for a total price of $179 + Tax. NO EXCEPTIONS.\n\nFor Guests who are prone to motion or seasickness, please be advised that surfing, stand up paddling, and other activities offered by us have been known to trigger symptoms. Many guests are able to limit these by taking the motion sickness medication of their choice ~30 minutes before their experience.\n\nPlease keep in mind that ocean activities require concentration/focus and are ALWAYS enjoyed best sober. Guests who are visibly inebriated or suspected of being under the influence of drugs/alcohol may be denied service and asked to reschedule for safety reasons.\n\nWhat to bring:\n\nPlease bring your swimsuit for under your wetsuit (if preferred), and sunscreen already on.\n\nThank you for choosing to book with Jamie O'Brien Surf Experience, we can't wait to share the best day ever with you!", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "Groups up to 12 people • Daily at 9AM", "short_description": "", "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/jobsurfexperience-sd/items/648512/images/1509550/", "pk": 1509550, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/V9NEqkYSGtLVUL982Uyg", "image_cdn_url": "https://cdn.filestackcontent.com/V9NEqkYSGtLVUL982Uyg", "company": {"cls": "Company", "uri": "/api/v1/companies/jobsurfexperience-sd/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/jobsurfexperience-sd/