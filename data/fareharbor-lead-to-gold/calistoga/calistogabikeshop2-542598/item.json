ns on the way back down.\n\nEach group we cater to has particular requests and questions - please give us a call to help you set up a unique adventure, whether for a corporate outing or a small group outing.\n\n##Package overview\n- Your bike or ours! We rent full-suspension, carbon fiber Santa Cruz and Specialized mountain bikes for our guests to enjoy.\n- Trail networks - We are within 40 minutes driving distance of 6 different riding parks in the region which present a broad spectrum of trails.\n- Trouble-free - Your guide carries most of the tools needed to make trailside repairs.\n- Additional time can be added and is billed by the hour.", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "For all ages • 4 hours", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/calistogabikeshop2/items/542598/images/1209033/", "pk": 1209033, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/eYyXNK3GQI6Xjo9xRPzO", "image_cdn_url": "https://cdn.filestackcontent.com/eYyXNK3GQI6Xjo9xRPzO", "company": {"cls": "Company", "uri": "/api/v1/companies/calistogabikeshop2/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/calistogabikeshop2/items/542598/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/eYyXNK3GQI6Xjo9xRPzO", "cropped_cdn_url": "https://cdn.filestackcontent.com/eYyXNK3GQI6Xjo9xRPzO", "is_low_resolution": true, "has_text_overlay": false, "has_logo_overlay": false}], "created_at": "2024-04-18T20:32:23+0000", "modified_at": "2025-10-23T20:11:23+0000", "is_gratuity_enabled": false, "is_sms_reminder_enabled": false, "receipt_footer": "", "is_scanning_enabled": false, "scanning_instructions": "", "external_url": "", "effective_pre_checkout_flow_node": {"cls": "FlowNode", "uri": "/api/v1/compani