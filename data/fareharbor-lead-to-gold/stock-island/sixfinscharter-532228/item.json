{"item": {"cls": "Item", "uri": "/api/v1/companies/sixfinscharter/items/532228/", "pk": 532228, "company": {"cls": "Company", "uri": "/api/v1/companies/sixfinscharter/", "pk": 110654, "shortname": "sixfinscharter", "name": "Six Fins Boat Charter - Perry Marina", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Private National Wildlife Refuge Eco Tour", "is_retail": false, "is_archived": false, "is_private": false, "color": 8, "unicode": "Private National Wildlife Refuge Eco Tour", "is_bookable_ever_by_phone": true, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 3.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 3.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 1655, "description": "#Embark on a voyage of discovery with our Eco Adventure Charter in Key West. \n\n##About\nEmbark on a voyage of discovery with our Eco Adventure Charter in Key West. Immerse yourself in the pristine beauty of our marine ecosystem as we explore secluded mangrove forests, vibrant coral reefs, and hidden coves teeming with life. Our knowledgeable guides will enlighten you about the delicate balance of this unique environment, highlighting the importance of conservation and sustainability.\n\n##Extra\nAll charter passengers may use The Perry Hotel and Marina pools & gym as my guests before and after the charter. David, Owner", "description_text": "", "description_bullets": "", "seo_description": "", "location": "Key West, Fl.", "booking_notes": "IMPORTANT ACTION REQUIRED\nSix Fins Charter – National Wildlife Refuge Eco Tour Confirmation\n\nDear Guests,\n\nWe’re excited to welcome you aboard your Private Eco Adventure Charter — a 3-hour exploration of protected backcountry waters surrounding Key West.\n\nPlease review the important details below to ensure a smooth and meaningful experience.\n\n✅ Before Your Tour\n\nFor trips up to six passengers:\n\n👉 Complete the insurance waiver: [here] (https://waiver.smartwaiver.com/w/rd9k5tiavpwper7h2rhaqh/web/)\n\nAND for trips with 7th and 8th passengers:\n\n👉 The primary renter (21+ years old) and captain must complete the Bareboat Agreement together at the dock before departure, but prior to arrival, you may begin: [here](https://waiver.smartwaiver.com/w/ez5636zbxexwrng7dtz6mq/web/)\n\nAll forms must be completed prior to arrival.\n\n🌿 Your Eco Experience\n\nThis private 3-hour tour explores:\n\n• Mangrove forests\n• Seagrass flats\n• National Wildlife Refuge waters\n• Dolphin and bird habitats\n• Protected shallow ecosystems\n\nYour captain will tailor the route based on wildlife activity and environmental conditions.\n\nWildlife sightings are common but cannot be guaranteed.\n\n📍 Departure Details\n\nDock A, Slip #32\n7001 Shrimp Rd\nStock Island, FL 33040\n\nPlease arrive 15 minutes prior to departure.\n\n🩺 Health & Safety\n\nThis is generally a calm-water tour.\n\nGuests should be comfortable boarding and riding on a vessel.\n\nThe captain may adjust route for safety and environmental protection.\n\n• Food allergies or dietary restrictions: reply to this email and let us know in advance so we can prepare.\n• Prone to seasickness: tell us ahead of time and we'll suggest what to take before boarding.\n\n🎁 Complimentary Access\n\nAs my charter guests, you may enjoy access to The Perry Hotel & Marina pools and fitness center before and after your tour.\n\nWe look forward to sharing the natural beauty of the Florida Keys with you.\n\nBest regards,\nDavid McFadden\nOwner, Six Fins Charter", "cancellation_notes": "Enjoy peace of mind with our cancellation policy:\n\nAll reservations made within 7 calendar days of departure are non-refundable. Customer cancellations made prior to 7 calendar days before departure will receive a full refund. If Six Fins Charter cancels due to unsafe weather conditions or other circumstances initiated by the owner/operator, the customer will receive a full refund.", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "Inside the federally protected refuges around the Lower Keys", "short_description": "", "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/sixfinscharter/items/532228/images/1157990/", "pk": 1157990, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/zhsgTdGSLqqeEFI08wIQ", "image_cdn_url": "https://cdn.filestackcontent.com/zhsgTdGSLqqeEFI08wIQ", "company": {"cls": "Company", "uri": "/api/v1/companies/sixfinscharter/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/sixfinscharter/items/532228/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/zhsgTdGSLqqeEFI08wIQ", "cropped_cdn_url": "https://cdn.filestackcontent.com/zhsgTdGSLqqeEFI08wIQ", "is_low_resolution": true, "has_text_overlay": false, "has_logo_overlay": false}, {"cls": "Image", "uri": "/api/v1/companies/sixfinscharter/items/532228/images/1228542/", "pk": 1228542, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/0Di2BwgDTfSsWuwW6ruB", "image_cdn_url": "https://cdn.filestackcontent.com/0Di2BwgDTfSsWuwW6ruB", "company": {"cls": "Company", "uri": "/api/v1/companies/sixfinscharter/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/sixfinscharter/items/532228/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/0Di2BwgDTfSsWuwW6ruB", "cropped_cdn_url": "https://cdn.filestackcontent.com/0Di2BwgDTfSsWuw