{"item": {"cls": "Item", "uri": "/api/v1/companies/sfjetskirentals/items/575607/", "pk": 575607, "company": {"cls": "Company", "uri": "/api/v1/companies/sfjetskirentals/", "pk": 94336, "shortname": "sfjetskirentals", "name": "Jetski Rentals of South Florida", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Searay Sundancer 55'", "is_retail": false, "is_archived": false, "is_private": false, "color": 5, "unicode": "Searay Sundancer 55'", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-midnight", "cutoff_unreached_hours": 3.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 0.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": true, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 44000, "description": "", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "SeaRay Sundancer 55’\n\nAddress: \n401 Biscayne Blvd\nMiami, Florida 33132 USA\n\nConfirmation:\nSeaRay Sundancer 55’\n\n###Here is some info that we hope will answer any questions you may have. \n\n1.) Please try and arrive a half hour early as we have sign coast guard documents and get you guys comfortable on the yacht. Safety first.\n\n2.) The crew and yacht will be ready for you for the start of your contracted time. The yacht runs on a tight schedule and adjusting start times is not an option. Please try and arrive early. \n\n3.) The captain will address all of your guests about safety first. It’s real important that everyone is paying attention. We take the safety of our guests very seriously. \n\n4.) Federal Law limits the maximum amount of guests allowed on a Recreational Bareboat Charter is 13. Kids count towards the total of 13. The captain and crew DO NOT count. Please make sure we don’t have more than 13 as there are no exceptions. \n\n5.) Everyone must remove their shoes while onboard the yacht. \n\n6.) Hookahs are NOT allowed on the yacht (no exceptions). Vapes are okay. \n\n7.) Use of the bathroom is allowed but you must dispose of toilet paper and / or personal hygiene products in the waste basket provided. A crew member will assist you with flushing the toilet. \n\n8.) The yacht has a Bluetooth surround sound system for your enjoyment. A crew member will assist you in getting you connected. Once connected we will set the stereo at a safe volume. If the volume needs to be adjusted a crew member will assist you.\n\n9.) The front master bedroom and bathroom are off limits to the guests as we have the owner’s personal belongings in there along with necessary documentation for the coast guard. The door has a sign that reads crew only no entry. Please respect the privacy of the owner. \n\n10.) We provide you with some ice and water for hydration. Please make sure you bring with you whatever you wish to eat and drink. Please make sure you bring cups and plates if you feel you will need them. \n\n11.) We will have a nice cruise from the historic Miami River to the anchorage area. We will be at the anchorage area for approximately 2 hours. You will then have the option to jump in the water, enjoy our floating Lili pad, or rent Jet Skis. If you wish to rent Jet Skis please let the captain know and he can reserve them. \n\n12.) If you have a balance remaining to be paid, the captain will collect it when your signing the coast guard documents on board the yacht. The balance must be paid in full before the yacht can leave the docks.\n\n####We accept the following forms of payment. \n- Cash\n- Zelle\n- Cash-app \n- Venmo\n- ApplePay \n\nThe total amount that you have paid for your charter does not include any gratuity / tip for the crew. If The Captain and First Mate do a great job ensuring your safety, comfort, & enjoyment. Please show your gratitude by tipping accordingly. Thank you!\n\nWhen you arrive PLEASE contact the captain and he will greet you at the main marina entrance door.\n\n#(If captains name and phone number is not in this confirmation, the captain will call you 24 hours prior to the day of the reservation.)", "cancellation_notes": "All sales are final. Once an order has been placed and confirmed, it cannot be canceled or refunded.\n\nPlease ensure that you have carefully reviewed your booking before submitting it.\n\nIf you have any questions about our cancellation policy or the item you wish to book, please contact us at (305) 990-2192", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "Up to 13 passengers", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/sfjetskirentals/items/575607/images/1282651/", "pk": 1282651, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/F92ZdX5MR3qq5h3XM7FW", "image_cdn_url": "https://cdn.filestackcontent.com/F92ZdX5MR3qq5h3XM7FW", "company": {"cls": "Company", "uri": "/api/v1/companies/sfjetskirentals/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/sfjetskirentals/items/575607/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/F92ZdX5MR3qq5h3XM7FW", "cropped_cdn_url": "https://cdn.filestackcontent.com/F92ZdX5MR3qq5h3XM7FW", "is_low_resolution": false, "has_text_overlay": false, "has_logo_overlay": false}, {"cls": "Image", "uri": "/api/v1/companies/sfjetskirentals/items/575607/images/1282654/", "pk": 1282654, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/xmlOMHbaQMiWLzyhlFq1", "image_cdn_u