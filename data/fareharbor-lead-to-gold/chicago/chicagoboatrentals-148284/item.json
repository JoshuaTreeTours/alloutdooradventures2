{"item": {"cls": "Item", "uri": "/api/v1/companies/chicagoboatrentals/items/148284/", "pk": 148284, "company": {"cls": "Company", "uri": "/api/v1/companies/chicagoboatrentals/", "pk": 21559, "shortname": "chicagoboatrentals", "name": "Chicago Boat Rentals", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Private Luxury Yacht Rental (12 Person Max)", "is_retail": false, "is_archived": false, "is_private": false, "color": 1, "unicode": "Private Luxury Yacht Rental (12 Person Max)", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-midnight", "cutoff_unreached_hours": 24.0, "is_cutoff_unreached_call_to_book": true, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 24.0, "is_cutoff_reached_call_to_book": true, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": 12, "maximum_subsequent_party_size": 12, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": true, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 9000, "description": "Take in the beautiful views of the Chicago skyline, shoreline, and riverfront from your private chartered yacht. \n\n(CAPTAIN IS NOT INCLUDED IN THE PRICE AND MUST BE PAID SEPARATELY)\n\n## What's Included\n- The top deck has a canopy optional flybridge with padded bench seating and a table right behind the captain seat with 360 unobstructed views.\n\n- Mid-deck has a  kitchen area with a fridge, wet bar, and an entertainment area with plenty of seating and a table for food, 2 bathrooms, and 2 separate sleeping areas\n- Swim platform with ladder\n- Excellent sound system\n- Life jackets  and safety equipment\n- 2 coolers on board\n- BYOB and Food\n\nOur \nThree-Hour charter on the Chicago River and pricing is listed by date.\n\n5-hour charters on Lake Michigan/Playpen are available.\n\nFireworks are Wednesday and Saturday nights on The Chicago River\n\nBefore reserving, please read through the rules and Coast Guard regulations.  You will also be required to fill out a waiver \n\n##50% Deposit is required at the time of booking to reserve the yacht.\n\nThe maximum number of people is 12 (plus captain and crew) There are no exceptions.\n\nYou may BYOB and food\nThere will be one large cooler on board and a refrigerator. \nPlease bring ice as there is no ice on board\n\nThe captain must be booked separately and is $100 per hour.  Once your deposit is made,  the available captain will call you within 48 hours.", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "Your reservation is confirmed. Please contact Captain Joe at 630-707-0626 and setup a deposit for your captain fee.\nThe captain fee is $100 per hour.\n\n\nPlease ensure you have no more than twelve people total.  A driver's license or state ID of the person booking must be shown when checking in.", "cancellation_notes": "50% Deposit is due at booking. The final payment is due one week before the event and will be charged automatically. We do not offer refunds or cancellations.  \n\nThe yacht will go out rain or shine. Please ensure you have read through all policies before booking.  There are no refunds or cancellations.", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "47 Ft Private Yacht Rental- (Bareboat Charter)", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/chicagoboatrentals/items/148284/images/1251888/", "pk": 1251888, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/zO7pvfyqQpeZApCddiBF", "image_cdn_url": "https://cdn.filestackcontent.com/zO7pvfyqQpeZApCddiBF", "company": {"cls": "Com