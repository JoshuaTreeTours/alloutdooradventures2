{"item": {"cls": "Item", "uri": "/api/v1/companies/soflnps/items/648246/", "pk": 648246, "company": {"cls": "Company", "uri": "/api/v1/companies/soflnps/", "pk": 131763, "shortname": "soflnps", "name": "South Florida National Park Service", "processor_currency": "usd", "display_processor_currency": "US dollars"}, "name": "Journey Through Nine Mile Pond: NPS Ranger-Guided Canoe Adventure", "is_retail": false, "is_archived": false, "is_private": false, "color": 1, "unicode": "Journey Through Nine Mile Pond: NPS Ranger-Guided Canoe Adventure", "is_bookable_ever_by_phone": false, "sold_out_text": "", "cutoff_unreached_kind": "before-start", "cutoff_unreached_hours": 48.0, "is_cutoff_unreached_call_to_book": false, "cutoff_unreached_call_to_book_text": "", "cutoff_reached_kind": "before-start", "cutoff_reached_hours": 48.0, "is_cutoff_reached_call_to_book": false, "cutoff_reached_call_to_book_text": "", "minimum_initial_party_size": 1, "minimum_subsequent_party_size": 1, "maximum_initial_party_size": null, "maximum_subsequent_party_size": null, "auto_open_kind": "before-start", "auto_open_hours": null, "is_waitlist_when_full": false, "is_unlisted": false, "booking_restriction": null, "is_card_required": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 1000, "description": "", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "**Journey Through Nine Mile Pond: NPS Ranger-Guided Canoe Adventure**\n\n**Departure Location:**\nWhere to Meet:\nPlease meet us at Nine Mile Pond, about 45 minutes from the Ernest F. Coe Visitor Center in Homestead or about 25 minutes from Flamingo.\n\nWhen to Meet: \nPlease arrive at least **30 minutes** prior to your program to check-in. We ask that you arrive by 8 am to take care of last-minute logistics, sign your waivers, and prepare to paddle. If you do not check-in with a ranger by 8:15 am, your place on the tour may be forfeited to other visitors. If you miss the 8:30 am safety talk, you are not permitted on the paddle.\n\n**There are no restroom facilities at Nine Mile Pond. Use the restrooms at the Ernest F. Coe Visitor Center before the Homestead Main Entrance gate or West Lake if coming from Flamingo.**\n\n**What to Bring:**\n•\tWater (required)\n•\tClosed-toe shoes with good tread (required)\n•\tSnacks\n•\tHat\n•\tSunglasses\n•\tSunscreen\n•\tBug spray or bug jacket\n•\tBinoculars\n•\tTowel\n•\tDry bags\n•\tBreathable long-sleeve shirt and long pants\n\n**Important Reminders:**\n•\tPrior paddling experience is required. If rangers don’t feel you can complete the trip safely, they may ask you to remove yourself from the trip.\n•\tAll minors must have an adult (18+) in the canoe with them.\n•\tEveryone will be issued life jackets and are required to wear them for the entire paddle.\n•\tAll visitors are required to sign a waiver. Parents or legal guardians can sign for minors.\n•\tThere are no bathrooms available at Nine Mile Pond. The closest bathrooms are 10 minutes away at West Lake.\n•\tYou may be asked to help us lift or move kayaks or canoes short distances.\n•\tPlan to get wet. You may want to leave valuables, such as phones or cameras, behind so they don’t get wet. A park ranger will bring a dry bag for your car keys, but will not carry any other belongings for you. The park and its rangers are not responsible for any damage to your personal belongings.\n\nWe look forward to seeing you in the ‘Glades soon!\n\nIf you have any questions, please email FlamingoVisitorCenter@gmail.com or call (239) 695-2945. Please allow 24 hours for a response.", "cancellation_notes": "Please be courteous and cancel with as much advance notice as possible so we can open your spot to other visitors.\n\nWe will only cancel the trip if there is severe weather preventing us from leading a safe experience. You will receive notification via email as well as a phone call. Conditions that may result in a cancellation include thunderstorms, lightning, or high winds. The trip could also be canceled if there is not enough water to safely follow the route.", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/soflnps/items/648246/images/1508754/", "pk": 1508754, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/XSSKY4YERRGnPCmKwrDO", "image_cdn_url": "https://cdn.filestackcontent.com/XSSKY4YERRGnPCmKwrDO", "company": {"cls": "Company", "uri": "/api/v1/companies/soflnps/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/soflnps/items/648246/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/XSSKY4YERRGnPCmKwrDO", "cropped_cdn_url": "https://cdn.filestackcontent.com/XSSKY4YERRGnPCmKwrDO", "is_low_resolution": false, "has_text_overlay": null, "has_logo_overlay": null}], "created_at": "2025-06-26T20:53:27+0000", "modified_at": "2025-07-15T16:25:38+0000", "is_gratuity_enabled": false, "is_sms_reminder_enabled": false, "receipt_footer": "", "is_scanning_enabled": false, "scanning_instructions": "", "external_url": "", "effective_pre_checkout_flow_node": null, "effective_post_checkout_flow_node": null, "settings": {"is_booking_fee_only": false, "is_booking_hold_capacity_enabled": false, "is_price_estimate_hidden": false, "is_item_abandoned_cart_enabled": true, "email_restriction": "", "is_seating_confirmations_enabled": false, "is_online_seating_enabled": false, "is_include_pending_in_live_capacity_enabled": false, "is_advanced_online_seating_enabled": false, "is_always_show_customer_counts": false, "is_online_installments_enabled": false, "is_online_booking_online_installments_enabled": false, "is_direct_booking_online_installments_enabled": false, "is_partial_payments_enabled": false, "is_seat_selection_required": false, "is_deposit_enabled": false, "deposit_modifier_kind": "offset", 