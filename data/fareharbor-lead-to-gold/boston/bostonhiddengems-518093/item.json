" events. Visit Concord's Old North Bridge, where the Minutemen routed the Redcoats on their march back to Boston!\n\nReturn to Boston to visit important sights along the Freedom Trail, including the Paul Revere House, Old North Church, USS Constitution (aka Old Ironside), the Bunker Hill Monument - home to the phrase \"don't fire until you see the white's of their eyes\", Old State House, Boston Common and more!", "description_text": "", "description_bullets": "", "seo_description": "", "location": "Boston, Lexington, Concord", "booking_notes": "", "cancellation_notes": "- You will receive a full refund if you cancel at least 14 days before your tour \n- You will receive a 50% refund if you cancel at least 7 days before your tour\n- No refunds within 7 days, but we will give you a 50% off coupon to book a new slot", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "Follow in the actual footsteps of the American Revolution in Boston, Concord, and Lexington!", "short_description": "", "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/bostonhiddengems/items/518093/images/1134884/", "pk": 1134884, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/XnqAMQ9ARBu0ct0wvwlw", "image_cdn_url": "https://cdn.filestackcontent.com/XnqAMQ9ARBu0ct0wvwlw", "company": {"cls": "Company", "uri": "/api/v1/companies/bostonhiddengems/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/bostonhiddengems/items/518093/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/XnqAMQ9ARBu0ct0wvwlw", "cropped_cdn_url": "https://cdn.filestackcontent.com/XnqAMQ9ARBu0ct0wvwlw", "is_low_resolution": false, "has_text_overlay": false, "has_logo_overlay": false}, {"cls": "Image", "uri": "/api/v1/companies/bostonhiddengems/items/518093/images/1116881/", "pk": 1116881, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/7jC88OlQTA2LlRCR291G", "image_cd