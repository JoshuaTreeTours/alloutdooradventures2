equired": false, "is_grouped_calendar": false, "is_free_allowed": true, "is_no_tax": true, "sortable_index": 32000, "description": "## Duration, Distance, Terrain\n1.5 hours\n0.7 miles at a moderate walking pace, stopping at various sites along the tour\nMostly flat surfaces and little to no inclines\n## About\nNew Tour for 2023 Join us on a members only Member Preview Tour, or later in the season when this new tour is open to general registrations.  \n\nJoin us to explore the rich past, present and future of Boston’s Leather District, nestled between South Station and Chinatown. Once part of South Cove and largely built after Boston’s Great Fire of 1872, this commercial district was the hub of New England’s leather and shoe industries at the turn of the 20th century.\n\nWalk past handsome historic brick and stone buildings, some with fanciful details honoring the cattle the leather trade depended on. We’ll also introduce you to Boston’s first dog catcher, celebrate America’s Community Health Center movement, and salute South Street Diner, an enduring favorite of clubgoers and other night owls.\n\nThe tour begins and ends at South Station, another star of our story with an outsized impact on the fortunes of the Leather District and one of several high-rise development sites that now hover at its edge.\n\n##Member Add On:\nRegister for the tour on select dates using your membership code for a free tour Add On option available to members\n- June 22, 2024 at 1p: Add on a guided discussion of additional stories unique to the Leather District\n- September 21, 2024 at 1p: Add on a guided discussion of additional stories unique to the Leather District\nBecome a [Boston By Foot member today] (https://bostonbyfoot.org/about/get-involved/Become-a-Member/) to enjoy free tours and special members events and activities. \n\n## Meeting location:\nMeet your guide in Dewey Square, diagonally across from the South Station entrance. Corner of Atlantic Avenue and Summer Street\n\nFinding Your Guide: All guides carry an 8×11 sign that says “Boston By Foot Walking Tours.”\n\nNearest Accessible MBTA Station: South Station (Red & Silver Lines and Commuter Rail)\n## What to bring\nComfortable shoes, dress for the weather, water bottle", "description_text": "", "description_bullets": "", "seo_description": "", "location": "", "booking_notes": "", "cancellation_notes": "", "no_transportation_notes": "", "no_transportation_minutes": 15, "headline": "Explore Boston’s Leather District, nestled between South Station and Chinatown", "short_description": null, "image_url": "", "image_cdn_url": "", "images": [{"cls": "Image", "uri": "/api/v1/companies/bostonbyfoot/items/378555/images/933179/", "pk": 933179, "unicode": "photo", "gallery": "carousel", "image_url": "https://cdn.filestackcontent.com/rpgcC0zQdm4DVeI0IT7A", "image_cdn_url": "https://cdn.filestackcontent.com/rpgcC0zQdm4DVeI0IT7A", "company": {"cls": "Company", "uri": "/api/v1/companies/bostonbyfoot/"}, "item": {"cls": "Item", "uri": "/api/v1/companies/bostonbyfoot/items/378555/"}, "crop": {}, "cropped_url": "https://cdn.filestackcontent.com/rpgcC0zQdm4DVeI0IT7A", "cropped_cdn_url": "https://cdn.filestackcontent.com/rpgcC0zQdm4DVeI0IT7A", "is_low_resolution": false, "has_text_overlay": false, "has_logo_overlay": false}], "created_at": "2022-04-22T11:50:28+0000", "modified_at": "2026-07-08T19:06:06+0000", "is_gratuity_enabled": false, "is_sms_reminder_enabled": false, "receipt_footer": "", "is_scanning_enabled": false, "scanning_instructions": "", "external_url": "", "effective_pre_checkout_flow_node": {"cls": "FlowNode", "uri": "/api/v1/companies/bostonbyfoot/flow-nodes/1104428/", "pk": 1104428, "unicode": "Series - Neighborhood", "company": {"cls": "Company", "uri": "/api/v1/companies/bostonbyfoot/"}, "name": "Series - Neighborhood", "short_name": "", "sortable_index": 262000, "is_rental": false}, "effective_post_checkout_flow_node": {"cls": "FlowNode", "uri": "/api/v1/companies/bostonbyfoot/flow-no